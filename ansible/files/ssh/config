# Github ────────────────────────────────────────────────────────────────────
Host github.com
  IdentityFile ~/.ssh/gmcgithub
  Port 22

# Home -----------------------------------------------------
Host mtl-gw
  User root
  Port 22

Host sanda
  Port 22

Host goliath*
  Port 22

Host ns3*
  Port 22

# Fleetwood ────────────────────────────────────────────────────────────────────

Host ldap*
  User gmc
  IdentityFile ~/.ssh/id_gmc

Host krb*
  User gmc
  IdentityFile ~/.ssh/id_gmc

# ╭───────────────────────────────────────────────────────────────────────────╮
